# PostgreSQL — ForgeRP runs on Postgres everywhere (Supabase in prod).
#   DATABASE_URL = pooled app runtime (Supabase Transaction pooler :6543)
#   DIRECT_URL   = Prisma CLI / db push / migrate ONLY
#
# Supabase gotcha (this hangs `npm run dev` on predev otherwise):
#   - DATABASE_URL → host …pooler.supabase.com PORT 6543  (transaction)
#   - DIRECT_URL   → host …pooler.supabase.com PORT 5432  (session mode)
#     OR the true direct host db.<ref>.supabase.co:5432
#   Never put :6543 on DIRECT_URL — Prisma db push will hang forever.
#
# For local Postgres, point both at the same URL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgerp?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forgerp?schema=public"

# Required for Carina's natural voice (Grok TTS) + AI answers
# Get a key at https://console.x.ai — never commit the real key
# Without XAI_API_KEY the app falls back to robotic browser speech.
XAI_API_KEY=
# XAI_MODEL=grok-4-fast
# Voice: POST /api/tts → https://api.x.ai/v1/tts  voice_id: carina
# TTS_VOICE_ID=carina
# Optional OpenAI-compatible speech fallback:
# TTS_API_URL=https://api.x.ai/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# Carina agent actions (finish WO, etc.): 1 = everyone (default), 0 = off, business = Business+ only
# CARINA_AGENT_ACTIONS=1

# Demo auth role (ADMIN, ENGINEERING, QUALITY, PURCHASING, PRODUCTION, etc.)
DEMO_USER_ROLE=ADMIN

# Auth mode:
#   unset / anything but "0" → evaluation (persona switcher open)
#   DEMO_MODE=0             → production (login required)
# DEMO_MODE=0

# Production plant deploys: also see .env.production.example

# ── Subscription billing (Stripe) — optional; unset = in-app activation ──
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...     # annual price IDs per plan
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_BUSINESS=price_...
# APP_URL=https://your-instance.example   # for checkout success/cancel URLs

# ── Support staff email alerts (new tickets + customer replies) ──
# Free key: resend.com — without it, chat still works; staff just aren't emailed.
# RESEND_API_KEY=re_...
# EMAIL_FROM="ForgeRP Support <support@yourdomain.com>"
# Optional override from-address for support only:
# SUPPORT_EMAIL_FROM="ForgeRP Support <support@yourdomain.com>"
# Who gets notified (comma-separated). If unset, all public-schema ADMIN users.
# SUPPORT_NOTIFY_EMAILS=forgerplanning@gmail.com

# ── Guided-tour voice (TTS) — optional; unset = browser speech synthesis ──
# TTS_API_URL=https://api.x.ai/v1/audio/speech   # any OpenAI-compatible TTS
# TTS_API_KEY=...                                 # falls back to XAI_API_KEY
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
